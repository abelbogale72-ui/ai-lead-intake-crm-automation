    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this lAnalyze this lead:\n\nName: {{ $json.fullName }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nSubject: {{ $json.subject }}\nMessage: {{ $json.message }}\nPriority: {{ $json.priority }}\n\nReturn exactly:\n\n{\n  \"intent\": \"sales|support|billing|general|other\",\n  \"summary\": \"short summary of the lead\",\n  \"lead_score\": 0,\n  \"recommendation\": \"Shortlist|Review|Reject\",\n  \"reason\": \"short reason for the recommendation\",\n  \"reply\": \"short professional reply to the lead\"\n}\n\nRules:\n- Fill every field.\n- lead_score must be a number from 0 to 100.\n- Do not use empty strings.\n- Return JSON only.ead:\n\nName: {{ $json.fullName }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nSubject: {{ $json.subject }}\nMessage: {{ $json.message }}\nPriority: {{ $json.priority }}\n\nReturn:\n{\n  \"intent\": \"sales|support|billing|general|other\",\n  \"summary\": \"short summary\",\n  \"lead_score\": 0,\n  \"recommendation\": \"Shortlist|Review|Reject\",\n  \"reason\": \"short reason\",\n  \"reply\": \"short professional reply\"\n} ",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a lead qualification AI. Analyze the lead using only the provided information. Fill every field. Return valid JSON only. Never leave fields empty."
            }
          ]
        },
        "batching": {}
      },
