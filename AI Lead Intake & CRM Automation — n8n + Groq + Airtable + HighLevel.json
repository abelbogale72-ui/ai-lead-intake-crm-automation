      "id": "6a93470a-827e-484a-904a-081162e1050d",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        -2208,
        896
      ],
      "credentials": {
        "groqApi": {
          "id": "bv7IFugUCbQWgXsv",
          "name": "Groq account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize & Validate Lead').first().json;\n\nconst raw =\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  $json.content ??\n  '';\n\nif (!raw) {\n  return [{\n    json: {\n      ...lead,\n      aiSuccess: false,\n      aiError: 'Groq returned no AI content',\n      aiRaw: $json\n    }\n  }];\n}\n\nlet parsed;\n\ntry {\n  const cleaned = String(raw)\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  return [{\n    json: {\n      ...lead,\n      aiSuccess: false,\n      aiError: 'Groq returned invalid JSON',\n      aiRaw: raw\n    }\n  }];\n}\n\nconst intent = String(parsed.intent ?? 'other').toLowerCase();\nconst summary = String(\n  parsed.summary ??\n  parsed.ai_summary ??\n  parsed.summary_text ??\n  ''\n).trim();\n\nconst score = Number(\n  parsed.lead_score ??\n  parsed.leadScore ??\n  parsed.score ??\n  0\n);\n\nconst recommendation = String(\n  parsed.recommendation ??\n  'Review'\n).trim();\n\nconst reason = String(\n  parsed.reason ??\n  parsed.ai_reason ??\n  ''\n).trim();\n\nconst reply = String(\n  parsed.reply ??\n  parsed.suggested_reply ??\n  ''\n).trim();\n\nconst allowedIntents = [\n  'sales',\n  'support',\n  'billing',\n  'general',\n  'other'\n];\n\nconst allowedRecommendations = [\n  'Shortlist',\n  'Review',\n  'Reject'\n];\n\nif (!summary || !reason || !reply || !Number.isFinite(score)) {\n  return [{\n    json: {\n      ...lead,\n      aiSuccess: false,\n      aiError: 'Groq response is missing required fields',\n      aiRaw: parsed,\n      intent,\n      summary,\n      lead_score: score,\n      recommendation,\n      reason,\n      reply\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...lead,\n\n    aiSuccess: true,\n    aiError: '',\n\n    intent: allowedIntents.includes(intent)\n      ? intent\n      : 'other',\n\n    aiSummary: summary,\n\n    leadScore: Math.max(\n      0,\n      Math.min(100, score)\n    ),\n\n    recommendation:\n      allowedRecommendations.includes(recommendation)\n        ? recommendation\n        : 'Review',\n\n    aiReason: reason,\n\n    suggestedReply: reply,\n\n    aiRaw: parsed\n  }\n}];"
      },
