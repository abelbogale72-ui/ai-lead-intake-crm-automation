    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\nconst clean = (v) => v === undefined || v === null ? '' : String(v).trim();\n\nconst fullName = clean(raw.fullName || raw.name);\nconst email = clean(raw.email).toLowerCase();\nconst phone = clean(raw.phone);\nconst company = clean(raw.company || raw.companyName);\nconst website = clean(raw.website);\nconst subject = clean(raw.subject);\nconst message = clean(raw.message || raw.inquiry || raw.notes);\nconst source = clean(raw.source) || 'Webhook';\n\nconst missing = [];\nif (!fullName) missing.push('fullName');\nif (!email) missing.push('email');\nif (!message) missing.push('message');\n\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  missing.push('valid email');\n}\n\nconst text = `${subject} ${message}`.toLowerCase();\nconst urgentWords = ['urgent','asap','emergency','critical','immediately','deadline','today','right away'];\nconst priority = urgentWords.some(w => text.includes(w)) ? 'High' : 'Normal';\n\nreturn [{\n  json: {\n    valid: missing.length === 0,\n    validationError: missing.length ? `Missing/invalid: ${missing.join(', ')}` : '',\n    requestId: `LEAD-${Date.now()}-${Math.random().toString(36).slice(2,8).toUpperCase()}`,\n    fullName, email, phone, company, website, subject, message, source,\n    priority,\n    status: 'New',\n    handled: false,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
